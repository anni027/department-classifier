# Copy to .env.production on the server and fill in. Never commit the real one.
#
# DOMAIN drives three things at once: the TLS certificate Caddy requests, the
# CORS origin the backend accepts, and the API URL baked into the frontend
# bundle. Changing it requires a rebuild, not just a restart.
DOMAIN=classifier.taqneeq.example

POSTGRES_USER=taqneeq
POSTGRES_DB=taqneeq
# Generate one: openssl rand -base64 24
POSTGRES_PASSWORD=
