# Automatic HTTPS via Let's Encrypt. Caddy needs ports 80 and 443 reachable
# from the internet for the ACME challenge — open both in the Lightsail
# firewall, not just 443.
{$DOMAIN} {
	encode gzip

	# API first: more specific route wins regardless of block order, but
	# keeping it first reads better.
	handle /api/* {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000
	}

	log {
		output stdout
		format console
	}
}
